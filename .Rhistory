library(dplyr)
library(Seurat)
library(patchwork)
library(HGNChelper)
library(plotly)
# Load the seurat_object dataset
raw_data_dir_1 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/NSCLC/SAMN13822232")
raw_data_dir_2 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/PC/SAMN16086829")
# Initialize the Seurat object with the raw (non-normalized data).
sample_1 <- CreateSeuratObject(counts = raw_data_dir_1, project = 'sample_1', min.cells = 3, min.features = 200)
sample_2 <- CreateSeuratObject(counts = raw_data_dir_2, project = 'sample_2', min.cells = 3, min.features = 200)
# The [[ operator can add columns to object metadata. This is a great place to stash QC stats
sample_1[["percent.mt"]] <- PercentageFeatureSet(sample_1, pattern = "^MT-")
sample_2[["percent.mt"]] <- PercentageFeatureSet(sample_2, pattern = "^MT-")
# Visualize QC metrics as a violin plot
VlnPlot(sample_1, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
sample_1 <- subset(sample_1, subset = nFeature_RNA > 200 & nFeature_RNA < 7500 & percent.mt < 25)
VlnPlot(sample_2, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
sample_2 <- subset(sample_2, subset = nFeature_RNA > 200 & nFeature_RNA < 7500 & percent.mt < 25)
srt_merged <- merge(x=sample_1, y=c(sample_2), add.cell.ids=c('sample1','sample2'))
srt_merged <- SCTransform(srt_merged, vars.to.regress = "percent.mt", verbose = T)
srt_merged <- RunPCA(srt_merged)
srt_integrated <- IntegrateLayers(object = srt_merged, method = CCAIntegration, normalization.method = "SCT", new.reduction='integrated', verbose = F) #any of the suggested integration methods in Seurat may be applied here for the methods parameter
srt_integrated <- FindNeighbors(srt_integrated, reduction = "integrated", dims = 1:30)
srt_integrated <- FindClusters(srt_integrated, resolution = 0.6)
srt_integrated <- RunUMAP(srt_integrated, dims = 1:10, reduction='integrated')
DimPlot(srt_integrated, reduction = "umap",group.by='orig.ident') + ggtitle('Integrated Plot')
## Run scType
# if scType option is selected, create cell type labels
db_ <- "https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/ScTypeDB_full.xlsx";
tissue <- "Immune system" # e.g. Immune system,Pancreas,Liver,Eye,Kidney,Brain,Lung,Adrenal,Heart,Intestine,Muscle,Placenta,Spleen,Stomach,Thymus
source("https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/R/gene_sets_prepare.R")
source("https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/R/sctype_score_.R")
gs_list = gene_sets_prepare(db_, tissue)
# get cell-type by cell matrix
es.max = sctype_score(scRNAseqData = srt_integrated[[DefaultAssay(srt_integrated)]]@scale.data, scaled = TRUE,
gs = gs_list$gs_positive, gs2 = gs_list$gs_negative)
# merge by cluster
cL_resutls = do.call("rbind", lapply(unique(srt_integrated@meta.data$seurat_clusters), function(cl){
es.max.cl = sort(rowSums(es.max[ ,rownames(srt_integrated@meta.data[srt_integrated@meta.data$seurat_clusters==cl, ])]), decreasing = !0)
head(data.frame(cluster = cl, type = names(es.max.cl), scores = es.max.cl, ncells = sum(srt_integrated@meta.data$seurat_clusters==cl)), 10)
}))
sctype_scores = cL_resutls %>% group_by(cluster) %>% top_n(n = 1, wt = scores)
# set low-confident (low ScType score) clusters to "unknown"
sctype_scores$type[as.numeric(as.character(sctype_scores$scores)) < sctype_scores$ncells/4] = "Unknown"
srt_integrated@meta.data$customclassif = ""
for(j in unique(sctype_scores$cluster)){
cl_type = sctype_scores[sctype_scores$cluster==j,];
srt_integrated@meta.data$customclassif[srt_integrated@meta.data$seurat_clusters == j] = as.character(cl_type$type[1])
}
## Done Running scType
DimPlot(srt_integrated, reduction = "umap", split.by='orig.ident', group.by='customclassif') + ggtitle('Cell Type Labels')
## Differential Gene Expression - this may crash your local computer - It is better to run this on a server
