library(dplyr)
library(Seurat)
library(patchwork)
library(HGNChelper)
library(plotly)
# Load the seurat_object dataset
raw_NSCLC_1 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/NSCLC/SAMN13822232")
raw_NSCLC_2 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/NSCLC/SAMN13822234")
#####raw_PC_1 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/PC/SAMN16086829")
#####raw_PC_2 <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/PC/SAMN16086830")
# Initialize the Seurat object with the raw (non-normalized data).
NSCLC_1 <- CreateSeuratObject(counts = raw_NSCLC_1, project = 'NSCLC_1', min.cells = 3, min.features = 200)
NSCLC_2 <- CreateSeuratObject(counts = raw_NSCLC_2, project = 'NSCLC_2', min.cells = 3, min.features = 200)
#####PC_1 <- CreateSeuratObject(counts = raw_PC_1, project = 'PC_1', min.cells = 3, min.features = 200)
#####PC_2 <- CreateSeuratObject(counts = raw_PC_2, project = 'PC_2', min.cells = 3, min.features = 200)
# The [[ operator can add columns to object metadata. This is a great place to stash QC stats
NSCLC_1[["percent.mt"]] <- PercentageFeatureSet(NSCLC_1, pattern = "^MT-")
NSCLC_2[["percent.mt"]] <- PercentageFeatureSet(NSCLC_2, pattern = "^MT-")
#####PC_1[["percent.mt"]] <- PercentageFeatureSet(PC_1, pattern = "^MT-")
#####PC_2[["percent.mt"]] <- PercentageFeatureSet(PC_2, pattern = "^MT-")
# Visualize QC metrics as a violin plot
## Replaced with my own established thresholds (differ with cell size, transcript. complexity, and mit content)
VlnPlot(NSCLC_1, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
NSCLC_1 <- subset(NSCLC_1, subset = nFeature_RNA > 200 & nFeature_RNA < 6000 & percent.mt < 20)
VlnPlot(NSCLC_2, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
NSCLC_2 <- subset(NSCLC_2, subset = nFeature_RNA > 200 & nFeature_RNA < 5000 & percent.mt < 15)
#####VlnPlot(PC_1, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
#####PC_1 <- subset(PC_1, subset = nFeature_RNA > 200 & nFeature_RNA < 4000 & percent.mt < 20)
#####VlnPlot(PC_2, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
#####PC_2 <- subset(PC_2, subset = nFeature_RNA > 200 & nFeature_RNA < 4000 & percent.mt < 20)
## Merging without barcode collisions, sample concatenation. Not batch effect correcting.
srt_merged <- merge(x=NSCLC_1, y=c(NSCLC_2), add.cell.ids=c('NSCLC_1','NSCLC_2')) # !!!! CHANGE TO PC WHEN RUNNING !!!
## SCTransform neg binomial regression to norm for seq depth, stabilize variance across genes, regress out confounders like percent.mt. Replaces NormalizeData -> ScaleData workflow.
srt_merged <- SCTransform(srt_merged, vars.to.regress = "percent.mt", verbose = TRUE)
## Reduces dimensionality using top variable genes identified by SCTransform. Used for CCA-based integration.
srt_merged <- RunPCA(srt_merged)
## IntegrateLayers() w CCAIntegration finds shared axes of variation (canonical correlates) across samples -> corrects batch effects by aligning cells in shared space.
## normalization.method = 'SCT' tells it to use the SCT-normalized data.
## new.reduction = 'integrated' names corrected embedding - what will be used for downstream steps.
## CCA appropriate because NSCLC vs PC have biologically distinct transcriptomes. CCA IDs cross-sample shared structure w/o over-correcting genuine biology (Harmony can over-integrate)
srt_integrated <- IntegrateLayers(object = srt_merged, method = CCAIntegration, normalization.method = "SCT", new.reduction='integrated', verbose = FALSE) #any of the suggested integration methods in Seurat may be applied here for the methods parameter
## Builds KNN graph in the integrated PCA space
srt_integrated <- FindNeighbors(srt_integrated, reduction = "integrated", dims = 1:30)
## Applies the Leiden/Louvain algorithm at resolution 0.6
srt_integrated <- FindClusters(srt_integrated, resolution = 0.6)
## ^^ higher resolution = more and smaller clusters vs lower resolution = fewer and broader clusters
## uses top 10 integrated PCs for the 2D embedding.
srt_integrated <- RunUMAP(srt_integrated, dims = 1:10, reduction='integrated')
## cells should intermix by sample if batch is corrected while still showing biological structure
DimPlot(srt_integrated, reduction = "umap",group.by='orig.ident') + ggtitle('Integrated UMAP - colored by sample')
## !!! Added on my own. Split by sample to see per-sample cluster contributions.
DimPlot(srt_integrated, reduction = "umap", split.by = "orig.ident") +
ggtitle("Integrated UMAP — split by sample")
## Run scType
# if scType option is selected, create cell type labels
db_ <- "https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/ScTypeDB_full.xlsx";
tissue <- "Lung" # e.g. Immune system,Pancreas,Liver,Eye,Kidney,Brain,Lung,Adrenal,Heart,Intestine,Muscle,Placenta,Spleen,Stomach,Thymus
source("https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/R/gene_sets_prepare.R")
source("https://raw.githubusercontent.com/IanevskiAleksandr/sc-type/master/R/sctype_score_.R")
gs_list = gene_sets_prepare(db_, tissue)
# get cell-type by cell matrix
es.max = sctype_score(scRNAseqData = srt_integrated[[DefaultAssay(srt_integrated)]]@scale.data, scaled = TRUE,
gs = gs_list$gs_positive, gs2 = gs_list$gs_negative)
# merge by cluster
## assign best cell type label per cluster
cL_resutls = do.call("rbind", lapply(unique(srt_integrated@meta.data$seurat_clusters), function(cl){
es.max.cl = sort(rowSums(es.max[ ,rownames(srt_integrated@meta.data[srt_integrated@meta.data$seurat_clusters==cl, ])]), decreasing = !0)
head(data.frame(cluster = cl, type = names(es.max.cl), scores = es.max.cl, ncells = sum(srt_integrated@meta.data$seurat_clusters==cl)), 10)
}))
sctype_scores = cL_resutls %>% group_by(cluster) %>% top_n(n = 1, wt = scores)
# set low-confident (low ScType score) clusters to "unknown"
sctype_scores$type[as.numeric(as.character(sctype_scores$scores)) < sctype_scores$ncells/4] = "Unknown"
srt_integrated@meta.data$customclassif = ""
for(j in unique(sctype_scores$cluster)){
cl_type = sctype_scores[sctype_scores$cluster==j,];
srt_integrated@meta.data$customclassif[srt_integrated@meta.data$seurat_clusters == j] = as.character(cl_type$type[1])
}
## Done Running scType
DimPlot(srt_integrated, reduction = "umap", split.by='orig.ident', group.by='customclassif') + ggtitle('Cell Type Labels - split by sample')
## Differential Gene Expression - this may crash your local computer - It is better to run this on a server
