library(tidyverse)
teen_births <- read_csv("C:/Users/nelin/Desktop/GWU Information/GWU Summer 2026/teenbirthrates1519.csv")
glimpse(teen_births)
teen_births <- teen_births %>%
filter(State == "Virginia")
glimpse(teen_births)
summary(teen_births)
teen_births <- teen_births %>%
rename(State_FIPS = "State FIPS Code",
County_FIPS = "County FIPS Code",
Birth_Rate = "Birth Rate",
Lower_CL = "Lower Confidence Limit",
Upper_CL = "Upper Confidence Limit")
glimpse(teen_births)
glimpse(teen_births)
# Creating 5th continuous variable
teen_births <- teen_births %>%
mutate(CI_Width = Upper_CL - Lower_CL)
glimpse(teen_births)
# Summary statistics
summary(teen_births$Year)
summary(teen_births$Birth_Rate)
summary(teen_births$Lower_CL)
summary(teen_births$Upper_CL)
summary(teen_births$CI_Width)
# Finding variance
var(teen_births$Year)
var(teen_births$Birth_Rate)
var(teen_births$Lower_CL)
var(teen_births$Upper_CL)
var(teen_births$CI_Width)
# Plot
ggplot(teen_births, aes( x = Year, y = Birth_Rate, group = County, color = County)) +
geom_line(alpha = 0.7) +
labs(title = "Teen Birth Rates by County, Virginia",
x = "Year", y = "Birth Rate (per 1,000 females aged 15-19)") +
theme_minimal() +
theme(legend.position = "none")
# Plot
highlight <- c("Loudon")
ggplot(teen_births, aes( x = Year, y = Birth_Rate, group = County, color = County)) +
geom_line(alpha = 0.7) +
labs(title = "Teen Birth Rates by County, Virginia",
x = "Year", y = "Birth Rate (per 1,000 females aged 15-19)") +
theme_minimal() +
theme(legend.position = "none")
highlight <- c("Loudoun")
ggplot(teen_births, aes( x = Year, y = Birth_Rate, group = County, color = County)) +
geom_line(alpha = 0.7) +
labs(title = "Teen Birth Rates by County, Virginia",
x = "Year", y = "Birth Rate (per 1,000 females aged 15-19)") +
theme_minimal() +
theme(legend.position = "none")
# County with the highest birth rate on record
teen_births %>%
filter(Birth_Rate == max(Birth_Rate))
# County with the lowest birth rate on record
teen_births %>%
filter(Birth_Rate == min(Birth_Rate))
# County with the widest confidence interval
teen_births %>%
filter(CI_Width == max(CI_Width))
highlight <- c("Petersburg City", "Loudoun")
ggplot(teen_births, aes(x = Year, y = Birth_Rate, group = County)) +
geom_line(color = "grey", alpha = 0.6) +
geom_line(data = filter(teen_births, County %in% highlight_counties),
aes(color = County), linewidth = 1.2) +
labs(title = "Teen Birth Rates by County, Virginia",
x = "Year", y = "Birth Rate (per 1,000 females aged 15-19)") +
theme_minimal()
