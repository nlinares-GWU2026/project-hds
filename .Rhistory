raw_data <- Read10X(data.dir = "C:/Users/nelin/Desktop/GWU Information/Advanced Genomic Data Analysis/scRNA_seq_data_NL_PROJECT/NSCLC/SAMN13822234")
# Initialize the Seurat object with the raw (non-normalized data).
seurat_object <- CreateSeuratObject(counts = raw_data, project = "NSCLC_2_Brain", min.cells = 3, min.features = 200)
seurat_object
# The [[ operator can add columns to object metadata. This is a great place to stash QC stats
seurat_object[["percent.mt"]] <- PercentageFeatureSet(seurat_object, pattern = "^MT-")
# Visualize QC metrics as a violin plot http://127.0.0.1:20838/graphics/71983ed5-6c5d-438c-84c7-f9827d9b9a0a.png
VlnPlot(seurat_object, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
ncol(seurat_object)
seurat_object <- subset(seurat_object, subset = nFeature_RNA > 200 & nFeature_RNA < 5000 & percent.mt < 15)
ncol(seurat_object)
