sctype_scores$type[as.numeric(as.character(sctype_scores$scores)) < sctype_scores$ncells/4] = "Unknown"
seurat_object@meta.data$customclassif = ""
for(j in unique(sctype_scores$cluster)){
cl_type = sctype_scores[sctype_scores$cluster==j,];
seurat_object@meta.data$customclassif[seurat_object@meta.data$seurat_clusters == j] = as.character(cl_type$type[1])
}
## Done Running scType
## Plot UMAP
DimPlot(seurat_object, reduction = "umap", split.by='orig.ident', group.by='customclassif') + ggtitle('Single Sample With Cell Type Labels')
